# AI provider routing. Groq is the primary; OpenRouter is the backup.
AI_PROVIDER=groq
AI_REQUEST_TIMEOUT_SECONDS=8
AI_ENABLE_GEMINI_FALLBACK=false

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Optional legacy provider. Disabled unless explicitly enabled above.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional app URL sent as OpenRouter metadata.
APP_PUBLIC_URL=https://ai-resume-job-matching-agent.onrender.com
